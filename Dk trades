<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TradesFuguetes - Steal a Brainrot</title>

  <style>
    * { margin:0; padding:0; box-sizing:border-box; font-family:"Rajdhani", sans-serif; }
    body { background:#0a0a0a; color:white; overflow-x:hidden; }

    header {
      width:100%; padding:20px; display:flex; justify-content:space-between;
      align-items:center; background:#0f0f0f; position:fixed; top:0; left:0;
      z-index:999; border-bottom:2px solid #8a00ff;
      animation:slideDown 0.8s ease;
    }
    @keyframes slideDown {
      from { transform:translateY(-60px); opacity:0; }
      to { transform:translateY(0); opacity:1; }
    }

    .logo { font-size:24px; font-weight:700; color:#b300ff; text-shadow:0 0 10px #b300ff; }
    nav a {
      margin-left:20px; text-decoration:none; color:white; font-size:18px;
      transition:0.3s; position:relative;
    }
    nav a:hover { color:#ff0044; }
    nav a::after {
      content:""; position:absolute; left:0; bottom:-4px; width:0%; height:2px;
      background:#ff0044; transition:0.3s;
    }
    nav a:hover::after { width:100%; }

    .banner {
      margin-top:90px; height:60vh;
      background:linear-gradient(45deg,#2b003d,#0c0014);
      display:flex; flex-direction:column; justify-content:center;
      align-items:center; text-align:center; padding:20px;
      animation:fade-in 1s ease-in-out;
    }
    .banner h1 {
      font-size:45px; text-shadow:0 0 15px #b300ff;
      animation:glow 2s infinite alternate;
    }
    .banner p { font-size:20px; margin-top:10px; opacity:0.8; }
    .btn {
      margin-top:20px; padding:15px 30px; background:#b300ff; color:white;
      border:none; border-radius:8px; font-size:20px; cursor:pointer;
      transition:0.3s; box-shadow:0 0 15px #b300ff;
    }
    .btn:hover { transform:scale(1.05); box-shadow:0 0 25px #ff0044; background:#ff0044; }

    @keyframes glow {
      from { text-shadow:0 0 10px #b300ff; }
      to { text-shadow:0 0 25px #ff0044; }
    }
    @keyframes fade-in {
      from { opacity:0; transform:translateY(30px); }
      to { opacity:1; transform:translateY(0); }
    }

    section { padding:60px 20px; }
    h2 { font-size:32px; text-shadow:0 0 10px #b300ff; margin-bottom:20px; }

    .form-box {
      max-width:500px; margin:auto; background:#110011; padding:25px;
      border-radius:12px; box-shadow:0 0 15px #b300ff;
      animation:fade-in 0.8s ease-in-out;
    }
    input, textarea {
      width:100%; padding:12px; margin-top:10px; border:none;
      border-radius:8px; background:#1a001f; color:white;
    }
    .send-btn {
      width:100%; margin-top:20px; padding:15px; background:#ff0044;
      border:none; border-radius:8px; color:white; font-size:18px;
      cursor:pointer; box-shadow:0 0 15px #ff0044; transition:0.3s;
    }
    .send-btn:hover { transform:scale(1.05); }
  </style>
</head>

<body>

<header>
  <div class="logo">TradesFuguetes</div>
  <nav>
    <a href="#home">Home</a>
    <a href="#dicas">Dicas</a>
    <a href="#recrutamento">Recrutamento</a>
    <a href="#loja">Loja</a>
    <a href="#contato">Contato</a>
  </nav>
</header>

<div class="banner" id="home">
  <h1>Steal a Brainrot - TradesFuguetes</h1>
  <p>Dicas, Recrutamento e Loja Oficial</p>
  <button class="btn" onclick="document.getElementById('recrutamento').scrollIntoView({behavior:'smooth'})">
    Entrar para a Tripulação
  </button>
</div>

<section id="recrutamento">
  <h2>Entre para a Tripulação</h2>
  <div class="form-box">
    <input id="nick" placeholder="Seu nick no jogo" />
    <input id="id" placeholder="Seu ID do jogador" />
    <textarea id="motivo" placeholder="Por que quer entrar?" rows="4"></textarea>
    <p style="margin-top:10px; font-size:14px; opacity:0.6;">
      nick: deirkzz (dono da Tripulação)
    </p>
    <button class="send-btn" onclick="sendDiscord()">Enviar Pedido</button>
  </div>
</section>

<script>
function sendDiscord() {
  const nick = document.getElementById('nick').value;
  const id = document.getElementById('id').value;
  const motivo = document.getElementById('motivo').value;

  const webhook = "https://discord.com/api/webhooks/1448738116646207620/ZxDB5J0Nw6MAc6B-B2visFnr44l6ke2HBvaLASj1RdfHLOp6wjfKu7ycCbPTUy1ICoYf";

  const content = {
    embeds: [
      {
        title: "📥 Novo Pedido de Recrutamento",
        color: 0xff0044,
        fields: [
          { name: "Nick", value: nick || "Não informado" },
          { name: "ID", value: id || "Não informado" },
          { name: "Motivo", value: motivo || "Não informado" }
        ]
      }
    ]
  };

  fetch(webhook, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(content)
  }).then(() => {
    alert("Pedido enviado! Já chegou no Discord.");
  }).catch(() => {
    alert("Erro ao enviar.");
  });
}
</script>

</body>
</html>
